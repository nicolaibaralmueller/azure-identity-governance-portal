# English texts for e-mails and server-generated portal texts (risk reasons, advisories, consent findings).
# da.psd1 must define the same keys. {0}, {1} are filled in with PowerShell's -f operator, so a literal
# brace must be doubled. Values may contain HTML where the e-mail template expects it.
@{
    # ── Risk reasons (SyncIdentityCache-Timer, SyncPrivilegedUsers-Timer, GetIdentities) ──
    # Keep ': ' before the specifics; the portal groups reasons by the text before the colon.
    'risk.noActiveOwner'        = 'No active owner - all owners are disabled accounts'
    'risk.noOwner'              = 'No owner'
    'risk.noOwnerAssigned'      = 'No owner assigned'
    'risk.ownerDisabled'        = 'Owner account disabled: {0}'
    'risk.minTwoOwners'         = 'Credential present - minimum two owners required (has {0})'
    'risk.expiredCred'          = 'Expired credential'
    'risk.expiringCred'         = 'Credential expiring soon'
    'risk.privRole'             = 'Privileged directory role: {0}'
    'risk.highPerm'             = 'High-risk API permission'
    'risk.noSignIn'             = 'No sign-in in {0} days'
    'risk.ssoNoCa'              = 'SSO app with no Conditional Access policy'
    'risk.noCa'                 = 'No Conditional Access policy'
    'risk.accountDisabledRoles' = 'Account disabled but has roles'
    'risk.privNoSignInRecord'   = 'Privileged user, no sign-in on record'
    'risk.privNoSignInDays'     = 'Privileged user, no sign-in in {0} days'

    # ── Advisories (SyncIdentityCache-Timer). Keep ' - ' after the headline; the portal groups on it. ──
    'adv.fedConfigured'         = 'Federated credentials already configured - this client secret may be removable'
    'adv.considerFederation'    = 'Renewing soon - consider workload identity federation instead of a new secret'
    'adv.secretLifetime'        = 'Secret issued for ~{0} months - standard is {1}'

    # ── Consent findings (SyncTenantConfig-Timer) ──
    'consent.userAllowAll'      = 'User consent is set to allow all apps. Users can grant any app access to your data without admin approval.'
    'consent.userVerified'      = 'User consent is limited to verified publishers. Consider disabling user consent entirely for tighter control.'
    'consent.userUnreadable'    = 'Could not read user consent settings. Verify Policy.Read.All is granted to the managed identity.'
    'consent.adminDisabled'     = 'Admin consent requests are disabled. Users cannot request access to apps requiring admin approval, which may lead to shadow IT.'
    'consent.adminNoReviewers'  = 'Admin consent requests are enabled but no reviewers are configured. Requests may go unreviewed.'
    'consent.emailOff'          = 'Email notifications for admin consent requests are disabled. Reviewers may miss incoming requests.'
    'consent.adminUnreadable'   = 'Could not read admin consent request settings. Verify Policy.Read.All is granted to the managed identity.'

    # ── Shared by both e-mails ──
    'mail.portalName'           = 'Identity Governance'
    'mail.days.one'             = '{0} day'
    'mail.days.other'           = '{0} days'
    'mail.daysAgo.one'          = '{0} day ago'
    'mail.daysAgo.other'        = '{0} days ago'
    'cred.Certificate'          = 'Certificate'
    'cred.Secret'               = 'Secret'

    # ── Expiry notification (SendExpiryNotifications-Timer) ──
    'mail.subject.renewed'      = '[Resolved] Credential renewed — {0}'
    'mail.subject.expired'      = '[EXPIRED] Credential expired — {0}'
    'mail.subject.expiredDays'  = '[EXPIRED {0}d] Still not renewed — {1}'
    'mail.subject.warning.one'  = '[{0} day] Credential expiry — {1}'
    'mail.subject.warning.other' = '[{0} days] Credential expiry — {1}'
    'mail.subhead.renewed'      = 'Credential Renewal Confirmed'
    'mail.subhead.expiry'       = 'Credential Expiry Notification'
    'mail.urgency.renewed'      = 'RENEWAL CONFIRMED'
    'mail.urgency.expiredToday' = 'EXPIRED - THIS APP MAY ALREADY BE FAILING'
    'mail.urgency.expiredDays'  = 'EXPIRED {0} DAYS AGO - STILL NOT RENEWED'
    'mail.urgency.today'        = 'EXPIRES TODAY'
    'mail.urgency.daysLeft'     = '{0} days remaining'
    'mail.renewTarget.appReg'   = '<strong>Certificates &amp; secrets</strong> for this application'
    'mail.renewTarget.sso'      = 'the <strong>Single sign-on</strong> page for this application'
    'mail.remaining.replaced'   = 'replaced'
    'mail.unnamed'              = '(unnamed)'
    'mail.lead.renewed'         = 'The credential below has been replaced. Nothing further is required &mdash; this app is covered again{0}.'
    'mail.lead.renewedUntil'    = ' until <strong>{0}</strong>'
    'mail.lead.expiredOrphaned' = 'The credential below <strong>has already expired</strong> and this application has <strong>no active owner</strong> &mdash; every listed owner account is disabled. Anything depending on it is likely failing now. Please assign a new owner and renew.'
    'mail.lead.expired'         = 'The credential below <strong>has already expired</strong>. Anything depending on it is likely failing now. This notice has also been sent to the identity governance coordinator.'
    'mail.lead.warning.one'     = 'The following credential is expiring and requires renewal. Please rotate or renew before the expiry date to avoid service disruption.'
    'mail.lead.warning.other'   = 'The following credentials are expiring and require renewal. Please rotate or renew before the expiry date to avoid service disruption.'
    'mail.fed'                  = '<strong>Before you renew:</strong> this application already has <strong>federated credentials</strong> configured. If the workload using this secret runs in GitHub Actions, Azure DevOps or AKS, it can authenticate without a secret at all &mdash; in which case the right action is to <strong>delete</strong> this credential rather than renew it.'
    'mail.cta'                  = 'Renew secret here'
    'mail.ctaOpens'             = 'Opens {0} in the Entra admin center.'
    'mail.guide.title'          = 'How to renew &mdash; in this order'
    'mail.guide.1'              = 'Create the <strong>new</strong> secret first. An app can hold several &mdash; the old one keeps working meanwhile. Set the expiry to at most <strong>{0} months</strong>.'
    'mail.guide.2'              = 'Copy the value <strong>immediately</strong>. Entra shows it once, at creation, and never again.'
    'mail.guide.3'              = 'Put it where the application reads it &mdash; Key Vault, app settings or a pipeline variable. Never in source code, e-mail or a ticket.'
    'mail.guide.4'              = 'Check that the application still works with the new secret.'
    'mail.guide.5'              = '<strong>Then</strong> delete the old secret. Deleting it before step 4 is the usual cause of an outage.'
    'mail.col.type'             = 'Type'
    'mail.col.name'             = 'Name'
    'mail.col.expires'          = 'Expires'
    'mail.col.remaining'        = 'Remaining'
    'mail.why'                  = 'This notification was triggered because you are listed as an owner of this application in Entra ID. You received this email because expiry notifications are enabled for this application in the Identity Governance.'
    'mail.footer'               = 'Identity Governance &mdash; automated notification &mdash; do not reply'

    # ── Monthly owner digest (SendOwnerDigest-Timer) ──
    'digest.subject.one'        = 'Your applications — {0} needs attention'
    'digest.subject.other'      = 'Your applications — {0} need attention'
    'digest.subhead'            = 'Your applications &mdash; monthly summary'
    'digest.hello'              = 'Hello {0}'
    'digest.own.one'            = 'You own <strong>{0}</strong> application with notifications enabled.'
    'digest.own.other'          = 'You own <strong>{0}</strong> applications with notifications enabled.'
    'digest.need.one'           = 'The following needs your attention over the next {1} days.'
    'digest.need.other'         = 'The following need your attention over the next {1} days.'
    'digest.rest'               = 'The rest are in good shape &mdash; no action needed there.'
    'digest.col.app'            = 'Application'
    'digest.col.status'         = 'Status'
    'digest.col.detail'         = 'Detail'
    'digest.sole.one'           = 'You are the <strong>only owner</strong> of {0} application. If you are away when a credential expires, nobody else is told. Adding a second owner is the single most useful thing you can do here &mdash; ask an administrator to add a colleague.'
    'digest.sole.other'         = 'You are the <strong>only owner</strong> of {0} applications. If you are away when a credential expires, nobody else is told. Adding a second owner is the single most useful thing you can do here &mdash; ask an administrator to add a colleague.'
    'digest.cta'                = 'Open Identity Governance'
    'digest.why'                = 'You receive this because you are an owner of these applications in Entra ID and expiry notifications are enabled on them. Switch notifications off for an application in the portal and it disappears from this summary. There is nothing to confirm or sign off &mdash; act only on what is listed above.'
    'digest.footer'             = 'Identity Governance &mdash; automated summary &mdash; do not reply'
    'digest.status.expired'     = 'Credential expired'
    'digest.status.expiresIn.one'   = 'Expires in {0} day'
    'digest.status.expiresIn.other' = 'Expires in {0} days'
    'digest.status.onlyOwner'   = 'Only owner'
    'digest.note.noSecondOwner' = 'no second owner to cover you'
    'digest.note.onlyOwner'     = 'you are the only owner'
}
